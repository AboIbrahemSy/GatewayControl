NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://gateway_control:change-me@postgres:5432/gateway_control
# Use a mounted file containing a base64- or hex-encoded 32-byte key in production.
GATEWAY_CONTROL_MASTER_KEY_FILE=/run/secrets/gateway_control_master_key
# GATEWAY_CONTROL_MASTER_KEY=
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=24
TRUST_PROXY=false
GATEWAY_PROTECTED_PROJECTS=gateway-control
GATEWAY_SYSTEM_BACKUP_LOCAL_ROOT=/opt/gateway-control/backups/system
GATEWAY_SYSTEM_BACKUP_NAS_ROOT=/mnt/gateway-control-backups
GATEWAY_SYSTEM_BACKUP_NAS_MARKER=.gateway-control-nas
GATEWAY_SYSTEM_RESTORE_STAGE_ROOT=/opt/gateway-control/backups/system/.restore-stage
