# Every setting also supports the Docker-secrets-style GATEWAY_*_FILE variant.
GATEWAY_CONTROL_URL=https://control.example.com
GATEWAY_ENROLLMENT_TOKEN_FILE=/run/secrets/gateway_enrollment_token
GATEWAY_AGENT_NAME=edge-01
# Mount this named volume at GATEWAY_STATE_DIR in the agent container.
GATEWAY_STATE_DIR=/var/lib/gateway-agent
GATEWAY_STATE_VOLUME=gateway-agent-state
# Bind this host directory at the same absolute path in the agent container.
GATEWAY_STACKS_ROOT=/opt/gateway-control/stacks
GATEWAY_HOST_STACKS_ROOT=/opt/gateway-control/stacks
# Bind the host procfs read-only at this location in the agent container.
GATEWAY_HOST_PROC_ROOT=/host/proc
GATEWAY_LOCAL_BACKUP_ROOT=/opt/gateway-control/backups/local
GATEWAY_HOST_LOCAL_BACKUP_ROOT=/opt/gateway-control/backups/local
GATEWAY_NAS_BACKUP_ROOT=/mnt/gateway-control-backups
GATEWAY_HOST_NAS_BACKUP_ROOT=/mnt/gateway-control-backups
GATEWAY_NAS_MARKER=.gateway-control-nas
# This must identify the same trusted, explicitly tagged Agent image.
GATEWAY_AGENT_IMAGE=example/gateway-agent:1.0.0
GATEWAY_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.3
GATEWAY_EDGE_NETWORK=gateway-control-edge
# Mount this named volume at GATEWAY_TRAEFIK_DYNAMIC_ROOT in both agent and Traefik containers.
GATEWAY_TRAEFIK_DYNAMIC_ROOT=/srv/traefik-dynamic
GATEWAY_TRAEFIK_DYNAMIC_VOLUME=gateway-traefik-dynamic
GATEWAY_HEARTBEAT_INTERVAL=30s
GATEWAY_METRICS_INTERVAL=30s
GATEWAY_BACKUP_TIMEOUT=60m
GATEWAY_LONG_POLL_TIMEOUT=50s
GATEWAY_COMMAND_TIMEOUT=5m
GATEWAY_DOCKER_INFO_TIMEOUT=10s
GATEWAY_MAX_OUTPUT_BYTES=20000
# Development only. Never enable this when credentials traverse an untrusted network.
GATEWAY_ALLOW_INSECURE_HTTP=false
GATEWAY_PROTECTED_PROJECTS=
