GATEWAY_CONTROL_IMAGE=gateway-control:local
GATEWAY_CONTROL_RELEASE=development
GATEWAY_AGENT_IMAGE=gateway-control-agent:local
GATEWAY_TRAEFIK_DYNAMIC_VOLUME=gateway-traefik-dynamic
GATEWAY_PROTECTED_PROJECTS=gateway-control
GATEWAY_NOTIFICATION_TOPOLOGY_MAX_AGENTS=100
GATEWAY_NOTIFICATION_TOPOLOGY_MAX_SERVICES=5000
GATEWAY_NOTIFICATION_TOPOLOGY_MAX_SCOPES=5000
CONTROL_HTTP_PORT=8080
POSTGRES_IMAGE=postgres:17-alpine
TRAEFIK_IMAGE=traefik@sha256:4299bbed850421258fc5448c2e0e6ad350981d4d335a68de11b92448aedbefe5
SESSION_TTL_HOURS=24
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false
GATEWAY_SYSTEM_BACKUP_LOCAL_ROOT=/opt/gateway-control/backups/system
GATEWAY_SYSTEM_BACKUP_LOCAL_HOST_ROOT=./data/backups/system
GATEWAY_SYSTEM_BACKUP_NAS_ROOT=/mnt/gateway-control-backups
GATEWAY_SYSTEM_BACKUP_NAS_HOST_ROOT=./data/backups/nas
GATEWAY_SYSTEM_BACKUP_NAS_MARKER=.gateway-control-nas
GATEWAY_SYSTEM_RESTORE_STAGE_ROOT=/opt/gateway-control/backups/system/.restore-stage
GATEWAY_SYSTEM_RESTORE_STAGE_HOST_ROOT=./data/backups/system/.restore-stage
UPDATE_BACKUP_ROOT=./data/backups/pre-update
GATEWAY_SYSTEM_BACKUP_MAX_BYTES=10737418240
GATEWAY_RECOVERY_SUPERVISOR_ENABLED=false
GATEWAY_RECOVERY_REQUEST_SECRET_HOST_FILE=./data/secrets/recovery-request.secret
# Set this to the in-container bind-mount path only after installing and mounting the opt-in host supervisor secret.
GATEWAY_RECOVERY_REQUEST_SECRET_CONTAINER_FILE=
